# ============================================================
# APP — Social Media Genius
# ============================================================
NEXT_PUBLIC_APP_NAME="Social Media Genius"
NEXT_PUBLIC_APP_URL=http://localhost:3050
PORT=3050
NODE_ENV=development

# ============================================================
# GOOGLE CLOUD & VERTEX AI
# ============================================================
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ============================================================
# DATABASE — Cloud SQL PostgreSQL
# ============================================================
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_NAME=
DATABASE_URL=

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# BETTER AUTH
# ============================================================
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3050

# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ============================================================
# GOOGLE CLOUD STORAGE
# ============================================================
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=

# ============================================================
# GOOGLE DRIVE
# ============================================================
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3050/api/auth/google-drive/callback

# ============================================================
# GOOGLE PICKER API
# ============================================================
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=

# ============================================================
# FIREBASE
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# GOOGLE ANALYTICS 4
# ============================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================================
# FEATURE FLAGS
# ============================================================
SKIP_URL_VALIDATION=true
DISABLE_RATE_LIMITING=true
NEXT_PUBLIC_ENABLE_LOGGING=true
